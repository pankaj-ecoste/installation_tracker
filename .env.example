VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Set to "true" to run entirely in-memory (mock DB, seed data), no Supabase connection.
VITE_TEST_MODE=false

# Optional local/demo override for "today" (ISO date, e.g. 2026-06-25).
# Leave unset in production so the app uses the real current date.
VITE_TODAY_OVERRIDE=
